# Application
APP_ENV=development
APP_NAME=real-estate-lead-bot

# Database (SQL - primary source of truth)
DATABASE_URL=postgresql://user:password@localhost:5432/real_estate_lead_bot

# FastAPI
API_BASE_URL=http://localhost:8000
API_V1_PREFIX=/api/v1

# n8n
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change-me-in-production

# AI / LLM Provider
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# Google Sheets (supporting operational layer)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Security
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Frontend (Vite) - only public values
# VITE_API_BASE_URL=http://localhost:8000/api/v1
